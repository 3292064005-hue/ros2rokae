# Canonical default runtime-host policy shared by CMake metadata, launch profiles,
# replay/install smoke staging, and release scoreboards.
# `ROKAE_DEFAULT_BACKEND_MODE` is the single public backend identity. Runtime-host
# ownership stays encoded separately in `ROKAE_DEFAULT_RUNTIME_HOST`.
ROKAE_DEFAULT_PUBLIC_LAUNCH_PROFILE=public_xmate_er3_sdk
ROKAE_DEFAULT_RUNTIME_HOST=daemonized_runtime
ROKAE_DEFAULT_RUNTIME_PROFILE=nrt_strict_parity
ROKAE_DEFAULT_BACKEND_MODE=effort
ROKAE_DEFAULT_SERVICE_EXPOSURE_PROFILE=public_xmate_er3_only
ROKAE_DEFAULT_ENABLE_ROS2_CONTROL=false
ROKAE_DEFAULT_ENABLE_XCORE_PLUGIN=false
ROKAE_DEFAULT_COMPATIBILITY_ALIAS_POLICY=canonical_plus_compat
# Legacy alias kept for direct policy-file readers. It must not drift from the
# canonical public backend identity above.
ROKAE_DEFAULT_METADATA_BACKEND_MODE=effort
