@PACKAGE_INIT@
include(CMakeFindDependencyMacro)

get_filename_component(_xcoresdk_pkg_prefix "${CMAKE_CURRENT_LIST_DIR}" DIRECTORY)
get_filename_component(_xcoresdk_pkg_prefix "${_xcoresdk_pkg_prefix}" DIRECTORY)
get_filename_component(_xcoresdk_pkg_prefix "${_xcoresdk_pkg_prefix}" DIRECTORY)

set(xCoreSDK_CANONICAL_PACKAGE "xCoreSDK")
set(xCoreSDK_LEGACY_SOURCE_PACKAGE "rokae_xmate3_ros2")
set(xCoreSDK_CANONICAL_IDENTITY "xCoreSDK:xmate_er3")
set(xCoreSDK_TARGET_FAMILY "xmate_er3")
set(xCoreSDK_PUBLIC_SCOPE "compat")
set(xCoreSDK_PRIMARY_INSTALL_CONSUMER "@ROKAE_PUBLIC_PRIMARY_INSTALL_CONSUMER@")
set(xCoreSDK_DEFAULT_BACKEND_MODE "@ROKAE_PUBLIC_DEFAULT_BACKEND_MODE@")
set(xCoreSDK_BACKEND_MODE "@ROKAE_PUBLIC_BACKEND_MODE@")
set(xCoreSDK_RUNTIME_DAEMON_DEFAULT @ROKAE_DAEMONIZED_RUNTIME_DEFAULT@)
set(xCoreSDK_RUNTIME_EXECUTABLE "rokae_sim_runtime")
set(xCoreSDK_UNSUPPORTED_MODULES "@ROKAE_PUBLIC_UNSUPPORTED_MODULES@")
set(xCoreSDK_XMATE_ER3_ONLY TRUE)
set(xCoreSDK_DEFAULT_LAUNCH_PROFILE "@ROKAE_PUBLIC_DEFAULT_LAUNCH_PROFILE@")
set(xCoreSDK_DEFAULT_RUNTIME_HOST "@ROKAE_PUBLIC_DEFAULT_RUNTIME_HOST@")
set(xCoreSDK_DEFAULT_RUNTIME_PROFILE "@ROKAE_PUBLIC_DEFAULT_RUNTIME_PROFILE@")
set(xCoreSDK_DEFAULT_SERVICE_EXPOSURE_PROFILE "@ROKAE_PUBLIC_DEFAULT_SERVICE_EXPOSURE_PROFILE@")
set(xCoreSDK_DEFAULT_ENABLE_ROS2_CONTROL "@ROKAE_PUBLIC_DEFAULT_ENABLE_ROS2_CONTROL@")
set(xCoreSDK_DEFAULT_ENABLE_XCORE_PLUGIN "@ROKAE_PUBLIC_DEFAULT_ENABLE_XCORE_PLUGIN@")
set(xCoreSDK_DEFAULT_COMPATIBILITY_ALIAS_POLICY "@ROKAE_PUBLIC_DEFAULT_COMPATIBILITY_ALIAS_POLICY@")

set(xCoreSDK_STRICT_PUBLIC_INSTALL TRUE)
set(xCoreSDK_INTERNAL_SURFACE_ENABLED FALSE)
set(xCoreSDK_PUBLIC_ROSIDL_ROOT "srv/")
set(xCoreSDK_INTERNAL_ROSIDL_ROOT "internal_interfaces/srv/")
set(xCoreSDK_PUBLIC_EXAMPLES_ROOT "examples/cpp/")
set(xCoreSDK_INTERNAL_EXAMPLES_ROOT "examples/internal/cpp/")

function(_xcoresdk_set_import_location_if_missing target relative_path language)
  if(NOT TARGET ${target})
    return()
  endif()
  get_target_property(_xcoresdk_existing_location ${target} IMPORTED_LOCATION_NOCONFIG)
  if(NOT _xcoresdk_existing_location)
    set_target_properties(${target} PROPERTIES
      IMPORTED_CONFIGURATIONS NOCONFIG
      IMPORTED_LOCATION_NOCONFIG "${_xcoresdk_pkg_prefix}/${relative_path}"
    )
    if(NOT "${language}" STREQUAL "")
      set_target_properties(${target} PROPERTIES
        IMPORTED_LINK_INTERFACE_LANGUAGES_NOCONFIG "${language}"
      )
    endif()
  endif()
  unset(_xcoresdk_existing_location)
endfunction()

find_dependency(Eigen3 REQUIRED NO_MODULE)
include("${CMAKE_CURRENT_LIST_DIR}/xCoreSDKCoreTargets.cmake")
_xcoresdk_set_import_location_if_missing(xCoreSDK::xCoreSDK_core "lib/libxCoreSDK_core.a" "CXX")
set(xCoreSDK_core_FOUND TRUE)

set(xCoreSDK_shared_FOUND FALSE)
set(xCoreSDK_static_FOUND FALSE)
set(xCoreSDK_ros_bridge_FOUND FALSE)

set(_xcoresdk_runtime_components "")
if(xCoreSDK_FIND_COMPONENTS)
  foreach(_component IN LISTS xCoreSDK_FIND_COMPONENTS)
    if(_component STREQUAL "core")
      continue()
    elseif(_component STREQUAL "shared" OR _component STREQUAL "static" OR _component STREQUAL "ros_bridge")
      list(APPEND _xcoresdk_runtime_components "${_component}")
    else()
      set(xCoreSDK_${_component}_FOUND FALSE)
    endif()
  endforeach()
endif()

set(_xcoresdk_load_runtime FALSE)
set(_xcoresdk_core_only TRUE)
if(_xcoresdk_runtime_components)
  set(_xcoresdk_load_runtime TRUE)
  set(_xcoresdk_core_only FALSE)
endif()

if(_xcoresdk_core_only)
  set(xCoreSDK_HAS_NATIVE_STATIC_TARGET FALSE)
  set(xCoreSDK_STATIC_PROVIDER "core-only")
endif()

if(_xcoresdk_load_runtime)
  find_dependency(ament_index_cpp REQUIRED CONFIG)
  find_dependency(rclcpp REQUIRED CONFIG)
  find_dependency(rclcpp_action REQUIRED CONFIG)
  find_dependency(std_msgs REQUIRED CONFIG)
  find_dependency(sensor_msgs REQUIRED CONFIG)
  find_dependency(geometry_msgs REQUIRED CONFIG)
  find_dependency(control_msgs REQUIRED CONFIG)
  find_dependency(trajectory_msgs REQUIRED CONFIG)
  find_dependency(rosidl_runtime_cpp REQUIRED CONFIG)
  find_dependency(unique_identifier_msgs REQUIRED CONFIG)
  find_dependency(action_msgs REQUIRED CONFIG)
  find_dependency(kdl_parser REQUIRED CONFIG)

  if(NOT TARGET rokae_xmate3_ros2::rokae_xmate3_ros2__rosidl_typesupport_cpp)
    set(_xcoresdk_rosidl_export_dir "${_xcoresdk_pkg_prefix}/share/rokae_xmate3_ros2/cmake")
    if(EXISTS "${_xcoresdk_rosidl_export_dir}/export_rokae_xmate3_ros2__rosidl_generator_cppExport.cmake")
      include("${_xcoresdk_rosidl_export_dir}/export_rokae_xmate3_ros2__rosidl_generator_cppExport.cmake")
    endif()
    if(EXISTS "${_xcoresdk_rosidl_export_dir}/rokae_xmate3_ros2__rosidl_typesupport_cppExport.cmake")
      include("${_xcoresdk_rosidl_export_dir}/rokae_xmate3_ros2__rosidl_typesupport_cppExport.cmake")
    endif()
    unset(_xcoresdk_rosidl_export_dir)
  endif()

  include("${CMAKE_CURRENT_LIST_DIR}/xCoreSDKTargets.cmake")
  _xcoresdk_set_import_location_if_missing(xCoreSDK::xCoreSDK_shared "lib/libxCoreSDK_shared.so" "")
  _xcoresdk_set_import_location_if_missing(xCoreSDK::xCoreSDK_static "lib/libxCoreSDK_static.a" "CXX")

  if(TARGET xCoreSDK::xCoreSDK_shared)
    set(xCoreSDK_shared_FOUND TRUE)
  endif()
  if(TARGET xCoreSDK::xCoreSDK_static)
    set(xCoreSDK_static_FOUND TRUE)
    set(xCoreSDK_HAS_NATIVE_STATIC_TARGET TRUE)
    set(xCoreSDK_STATIC_PROVIDER "native-static")
  else()
    set(xCoreSDK_HAS_NATIVE_STATIC_TARGET FALSE)
    set(xCoreSDK_STATIC_PROVIDER "unavailable")
  endif()
  if(TARGET xCoreSDK::xCoreSDK_ros_bridge)
    set(xCoreSDK_ros_bridge_FOUND TRUE)
  endif()

  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/xCoreSDKPrivateTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/xCoreSDKPrivateTargets.cmake")
  endif()
endif()

unset(_xcoresdk_runtime_components)
unset(_xcoresdk_load_runtime)
unset(_xcoresdk_core_only)
unset(_xcoresdk_pkg_prefix)
unset(_xcoresdk_set_import_location_if_missing)

check_required_components(xCoreSDK)
